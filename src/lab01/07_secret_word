string = input()
word = ''
gap = 0
for j in range(len(string)):
    if string[j] == string[j].upper():
        word = string[j:]
        break
for i in range(len(word) - 1):
    if word[i].isdigit():
        gap = i + 1
        break
orig_word = word[::gap]
if orig_word.count('.') == 0:
    orig_word += '.'
print(orig_word)