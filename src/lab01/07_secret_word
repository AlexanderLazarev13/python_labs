string = input()
word = ''
gap = 0
for i in range(len(string)):
    if string[i] == string[i].upper():
        word = string[i:]
        break
for j in range(len(word) - 1):
    if word[j].isdigit():
        gap = j + 1
        break
orig_word = word[::gap]
if orig_word.count('.') == 0:
    orig_word += '.'
print(orig_word)
